# PostgreSQL
DB_USER=postgres
DB_HOST=localhost
DB_NAME=Administrasi Santri Digital
DB_PASSWORD=
DB_PORT=5432

# PostgreSQL backup/restore (optional)
# DATABASE_URL=postgresql://user:password@host:5432/database
# BACKUP_DIR=./backups
# PG_DUMP_PATH=pg_dump
# PG_RESTORE_PATH=pg_restore
# BACKUP_UPLOAD_MAX_BYTES=1073741824

# Auth
JWT_SECRET=
WALI_JWT_SECRET=
WALI_JWT_EXPIRES=30d
WALI_JWT_ALLOW_LEGACY_NO_AUD=true
WALI_TOKEN_VERSION_ENABLED=false

# Server
PORT=3000

# Socket.io + CORS (canonical production admin origin)
CORS_ORIGIN=https://app.klikpesantren.com
FRONTEND_URL=https://app.klikpesantren.com

# Optional: used by dev scripts only
# API_BASE_URL=http://localhost:3000

# Billing expiry checker (manual script only)
# BILLING_GRACE_DAYS=7

# Tenant DNS provisioning (backend only)
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ZONE_ID=
# TENANT_DOMAIN_TARGET=cname.vercel-dns.com
# CLOUDFLARE_DNS_DRY_RUN=true

# Tenant Vercel domain provisioning (backend only)
# VERCEL_API_TOKEN=
# VERCEL_PROJECT_ID=
# VERCEL_TEAM_ID=
# VERCEL_DOMAIN_DRY_RUN=true
# TENANT_DOMAIN_AUTO_PROVISION=true
